{% extends "base.html.j2" %}
{% set logo_initials = bank_name[:2] | upper %}
{% block title %}Account statement{% endblock %}
{% block issuer %}{{ bank_name }}{% endblock %}
{% block content %}
<h1>Account statement</h1>
<dl>
  <dt>Account holder</dt><dd>{{ account_holder }}</dd>
  <dt>Address</dt><dd>{{ address.street }}, {{ address.postcode }} {{ address.city }}</dd>
  <dt>IBAN</dt><dd>{{ iban }}</dd>
  <dt>Period</dt><dd>{{ period_start }} to {{ period_end }}</dd>
  <dt>Currency</dt><dd>{{ currency }}</dd>
</dl>
<h2>Transactions</h2>
<table>
  <thead><tr><th>Date</th><th>Description</th><th class="amount">Money in</th><th class="amount">Money out</th><th class="amount">Balance</th></tr></thead>
  <tbody>
  {% for row in rows %}
    <tr{% if row.edited %} class="edited"{% endif %}>
      <td>{{ row.date }}</td><td>{{ row.description }}</td>
      <td class="amount">{{ money(row.money_in) }}</td><td class="amount">{{ money(row.money_out) }}</td>
      <td class="amount">{{ money(row.balance) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<h2>Summary</h2>
<table>
  <tr><th>Opening balance</th><td class="amount">{{ money(opening_balance) }}</td></tr>
  <tr><th>Total money in</th><td class="amount">{{ money(total_in) }}</td></tr>
  <tr><th>Total money out</th><td class="amount">{{ money(total_out) }}</td></tr>
  <tr><th>Closing balance</th><td class="amount">{{ money(closing_balance) }}</td></tr>
</table>
{% endblock %}
